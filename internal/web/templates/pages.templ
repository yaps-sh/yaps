package templates

import (
	"fmt"

	"github.com/yaps-sh/yaps/internal/build"
	"github.com/yaps-sh/yaps/internal/paste"
)

const (
	indexDescription = "A small, self-hostable pasting service. Free to use, forever."
	aboutDescription = "About yaps.sh - a small, self-hostable pasting service."
)

templ Index(baseURL string) {
	@layout("yaps.sh", indexHead(baseURL)) {
		@index(PrimaryLanguages, AllLanguages())
	}
}

templ About(bld build.Info, latest string, baseURL string) {
	@layout("yaps.sh - about", aboutHead(baseURL)) {
		@about(bld, latest)
	}
}

templ View(entry *paste.Entry, highlighted string, baseURL string) {
	@layout(title(entry), ogHead(entry, baseURL)) {
		@view(entry, highlighted)
	}
}

templ metaHead(title, desc, url, typ, card string) {
	<meta name="description" content={ desc }/>
	<meta property="og:title" content={ title }/>
	<meta property="og:description" content={ desc }/>
	<meta property="og:type" content={ typ }/>
	<meta property="og:url" content={ url }/>
	<meta property="og:site_name" content="yaps.sh"/>
	<meta name="twitter:card" content={ card }/>
	<meta name="twitter:title" content={ title }/>
	<meta name="twitter:description" content={ desc }/>
	<link rel="canonical" href={ url }/>
}

templ indexHead(baseURL string) {
	@metaHead("yaps.sh", indexDescription, baseURL, "website", "summary")
}

templ aboutHead(baseURL string) {
	@metaHead("yaps.sh - about", aboutDescription, fmt.Sprintf("%s/about", baseURL), "website", "summary")
}

templ ogHead(entry *paste.Entry, baseURL string) {
	@metaHead(ogTitle(entry), ogDescription(), fmt.Sprintf("%s/%s", baseURL, entry.ID), "article", "summary_large_image")
	<meta property="og:image" content={ ogImageURL(entry, baseURL) }/>
	<meta name="twitter:image" content={ ogImageURL(entry, baseURL) }/>
}

func title(entry *paste.Entry) string {
	if entry.Filename != nil {
		return fmt.Sprintf("yaps.sh - %s", *entry.Filename)
	}
	return fmt.Sprintf("yaps.sh - %s", entry.ID)
}

func ogTitle(entry *paste.Entry) string {
	if entry.Filename != nil && *entry.Filename != "" {
		return *entry.Filename
	}
	return fmt.Sprintf("yaps.sh/%s", entry.ID)
}

func ogDescription() string {
	return "A paste on yaps.sh"
}

func ogImageURL(entry *paste.Entry, baseURL string) string {
	return fmt.Sprintf("%s/%s/og.png", baseURL, entry.ID)
}
