package templates

import (
	"github.com/dustin/go-humanize"
	"github.com/yaps-sh/yaps/internal/paste"
)

templ view(entry *paste.Entry, hightlighted string) {
	<meta name="robots" content="noindex, nofollow"/>
	<style>
		.bottom-bar {
			flex-shrink: 0;
			border-top: 1px solid var(--border);
			background: var(--background-raised);
			padding: 0.65rem 1.25rem;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			flex-wrap: wrap;
		}

		.bottom-bar-left {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			min-width: 0;
		}

		.bottom-bar-right {
			display: flex;
			align-items: center;
			gap: 1.1rem;
			flex-shrink: 0;
		}

		.view-filename {
			font-family: var(--font-mono);
			font-size: 0.85rem;
			color: var(--foreground);
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.view-filename.untitled {
			color: var(--foreground-faint);
			font-style: normal;
		}

		.view-tag {
			display: inline-flex;
			align-items: center;
			background: var(--background);
			border: 1px solid var(--border);
			border-radius: 999px;
			padding: 0.2rem 0.65rem;
			font-family: var(--font-sans);
			font-size: 0.75rem;
			color: var(--foreground-muted);
			flex-shrink: 0;
		}

		.action-link {
			font-size: 0.82rem;
			color: var(--foreground-muted);
			transition: color 0.15s ease;
		}

		.action-link:hover {
			color: var(--foreground);
		}

		.action-link.primary {
			color: var(--accent);
			font-weight: 500;
		}

		.action-link.primary:hover {
			color: var(--accent);
			opacity: 0.85;
		}

		.copy-link,
		.wrap-toggle {
			appearance: none;
			background: none;
			border: none;
			padding: 0;
			font-family: inherit;
			cursor: pointer;
		}

		.copy-link:disabled {
			cursor: default;
			opacity: 0.7;
		}

		.view-content-wrap {
			flex: 1;
			display: flex;
			min-height: 0;
			overflow: auto;
		}

        .view-content-wrap .chroma {
            flex: 1;
            margin: 0;
            padding: 1.25rem;
            background: var(--background) !important;
            font-family: var(--font-mono);
            font-size: 0.9rem;
            line-height: 1.6;
            overflow-x: auto;
            tab-size: 4;
        }

        .view-content-wrap .chroma .ln {
            position: sticky;
            left: 0;
        }

        .view-content-wrap .chroma.wrap .cl {
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }
	</style>
	<div class="view-content-wrap">
		@templ.Raw(hightlighted)
	</div>
	<template id="paste-raw">{ entry.Content }</template>
	<div class="bottom-bar">
		<div class="bottom-bar-left">
			if entry.Filename != nil {
				<span class="view-filename">{ *entry.Filename }</span>
			} else {
				<span class="view-filename untitled">untitled</span>
			}
			<span class="view-tag">{ entry.DetectedLanguage }</span>
			<span class="view-tag">{ humanize.Bytes(uint64(entry.SizeBytes)) }</span>
			if entry.ViewCount == 1 {
				<span class="view-tag">1 view</span>
			} else {
				<span class="view-tag">{ entry.ViewCount } views</span>
			}
		</div>
		<div class="bottom-bar-right">
			<button type="button" class="action-link copy-link" onclick="copyPasteContent(this)">Copy</button>
			<button type="button" class="action-link wrap-toggle" aria-pressed="false" onclick="toggleWrap(this)">Wrap</button>
			<a href={ templ.URL("?view=raw") } class="action-link">Raw</a>
			<a href="/" class="action-link primary">New Paste</a>
		</div>
	</div>
	<script>
		function copyPasteContent(btn) {
            const tpl = document.getElementById('paste-raw');
            const content = tpl ? tpl.content.textContent : '';
            navigator.clipboard.writeText(content).then(() => {
                const original = btn.textContent;
                btn.textContent = 'Copied';
                btn.disabled = true;
                setTimeout(() => {
                    btn.textContent = original;
                    btn.disabled = false;
                }, 1500);
            });
        }

        function toggleWrap(btn) {
            const chroma = document.querySelector('.chroma');
            if (!chroma) return;
            const wrapped = chroma.classList.toggle('wrap');
            btn.setAttribute('aria-pressed', String(wrapped));
            try { localStorage.setItem('yaps.wrap', wrapped ? '1' : '0'); } catch (_) {}
        }

        (function initWrap() {
            const chroma = document.querySelector('.chroma');
            const btn = document.querySelector('.wrap-toggle');
            if (!chroma || !btn) return;
            let wrapped = false;
            try { wrapped = localStorage.getItem('yaps.wrap') === '1'; } catch (_) {}
            if (wrapped) {
                chroma.classList.add('wrap');
                btn.setAttribute('aria-pressed', 'true');
            }
        })();
	</script>
}
